# Environment Configuration
# ========================

# Environment: "development" or "production"
# In development mode, emails are logged to console instead of being sent
NODE_ENV="development"

# Server Configuration
# --------------------
PORT=3030
MONGODB_PORT=27017

# Interface to bind. Defaults to 127.0.0.1 when NODE_ENV=development and
# 0.0.0.0 otherwise. Development REFUSES TO START on a non-loopback address:
# routes/auth.js still carries a DEV_USERS list gated only on NODE_ENV, so a
# development process must not be reachable off the machine.
# Production runs with NODE_ENV unset (see ecosystem.config.js), so the default
# there stays 0.0.0.0 and nothing changes.
# HOST="127.0.0.1"

# Full MongoDB connection URI. OPTIONAL — overrides the URI otherwise assembled
# from MONGODB_PORT as mongodb://localhost:${MONGODB_PORT}/komondor.
# Whichever URI is used is validated at boot and MUST name a database: a URI
# ending at the host connects to the driver's default database, which is how a
# deployment silently comes up against the wrong data.
# Replica sets are supported (mongodb://a:27017,b:27017/komondor).
# MONGODB_URI="mongodb://localhost:27017/komondor"

# Authentication
# --------------
# Secret for signing JWT tokens - use a strong random string in production
JWT_SECRET="your-secure-jwt-secret-here"

# How long an issued token stays valid (any ms-style string: "12h", "30d").
# Default "7d". Group membership is a login-time snapshot baked into the token,
# so this is also the upper bound on how stale that snapshot can get.
# JWT_EXPIRES_IN="7d"

# LDAP Configuration for Active Directory authentication
LDAP_URL="ldap://DOMAIN.ac.uk:PORT"
LDAP_BIND_DN="ldapuser"
LDAP_BIND_CREDENTIALS="password"
LDAP_SEARCH_BASE="OU=NBIUsers,dc=nbi,dc=ac,dc=uk"
LDAP_SEARCH_FILTER="(sAMAccountName={{username}})"

# Admin password for special admin operations
ADMIN_PASSWORD="password"

# File Storage Configuration
# --------------------------
# Root directory for storing data files (sync with komondor-web)
DATASTORE_ROOT="/var/datastore-root"

# Directory on HPC for temporary file transfers
HPC_TRANSFER_DIRECTORY="/hpc/tempWebUploadsDir"

# How long a file transfer may run, in minutes, before it is treated as stalled
# rather than active. Default 360 (6 hours). Without a bound, one copy hung on
# an unresponsive mount blocks every clean shutdown indefinitely.
# STALLED_TRANSFER_MINUTES=360

# Access Control
# --------------
# Users who may read every record regardless of group membership, and who may
# use the cross-group accessions export at GET /accessions/csv (JSON array, or a
# comma-separated list). Matched exactly, not as a substring.
#
# Keep this in step with komondor-web's ENA_ADMINS: the export page is offered
# to the users listed there, and the API refuses anyone not listed here.
FULL_RECORDS_ACCESS_USERS=["some", "usernames", "here"]

# Email Configuration
# -------------------
# Email addresses to receive ENA submission notifications (JSON array)
ENA_ADMIN_EMAILS=["admin@example.com"]

# SMTP server settings
SMTP_HOST="mail.example.com"
SMTP_PORT=25
SMTP_FROM="TSL sequences site <bioinformatics@tsl.ac.uk>"

# CORS Configuration
# ------------------
# Only accept API requests from this origin (komondor-web or komondor-power URL)
WEB_APP_URL="http://localhost:3000"

# MD5 Verification Configuration
# -------------------------------
# Set to "true" to skip MD5 verification entirely (emergency use only)
# SKIP_MD5_VERIFICATION="false"

# Options endpoint write protection
# --------------------------------
# POST/DELETE on /options/* require an ADMIN token by default (it used to be
# any valid token). GET is always public.
# Set to "false" only as a local development opt-out. It is IGNORED when
# NODE_ENV is "production" — the gate cannot be lifted there.
# OPTIONS_WRITE_REQUIRE_AUTH="true"

# Ingest queue worker
# -------------------
# Background worker that performs the file ingest for POST /runs/new. The run
# is created and the job queued synchronously; the files move afterwards.
# If the worker is not running, runs stay at status "pending" forever.
#
# Poll interval in milliseconds. lib/ingest-queue.js owns the default; set this
# only to override it. VALIDATED AT BOOT: when set it must be an integer
# between 250 and 300000 (5 minutes). Leaving it unset means "use the queue's
# default" and is always valid; an out-of-range value refuses the boot.
# INGEST_POLL_MS=

# How long a worker's exclusive hold on a job lasts, in minutes. The default is
# sized deliberately against multi-terabyte ingests (the MD5 pass is unbounded
# in duration). A lease that expires mid-MD5 is recoverable — the background
# job re-verifies anything left at md5VerificationStatus "pending".
# VALIDATED AT BOOT: when set it must be an integer between 1 and 1440
# (24 hours). Unset means "use the queue's default".
# INGEST_LEASE_MINUTES=

# How long without a worker poll before /ready reports the worker as stale.
# INGEST_TICK_STALE_MINUTES=

# Dedicated read-only credential used by komondor-power's durable status monitor.
# Generate at least 32 random characters; match Power's NUXT_POWER_STATUS_TOKEN.
# Never expose this credential in browser/public configuration.
# POWER_STATUS_TOKEN=

# Upload limits (tus resumable uploads)
# -------------------------------------
# Largest single upload, in bytes. Default 53687091200 (50 GiB).
# UPLOAD_MAX_BYTES=53687091200

# Concurrent in-flight uploads allowed per user. Default 10.
# UPLOAD_MAX_CONCURRENT_PER_USER=10

# Total in-flight bytes allowed per user. Default 214748364800 (200 GiB).
# UPLOAD_MAX_INFLIGHT_BYTES_PER_USER=214748364800

# Refuse an upload that would leave less than this much free disk, in bytes.
# Default 5368709120 (5 GiB) — sized so a small dev disk still works.
# RAISE THIS IN PRODUCTION.
# UPLOAD_MIN_FREE_BYTES=5368709120

# Minutes without progress before an upload counts as idle. Default 60.
# UPLOAD_IDLE_MINUTES=60

# Hours before an untouched partial upload counts as abandoned. Default 48.
# UPLOAD_ABANDONED_HOURS=48

# Where tus stores in-progress uploads. Default <cwd>/files.
# Safe to set. Every consumer now resolves it through lib/utils/uploadPath.js —
# routes/uploads.js, lib/file-utils.js, lib/background-jobs.js, models/File.js,
# app.js and lib/utils/validateEnv.js — so a finished upload is claimed from the
# same directory it was staged in. (This entry previously warned it was a
# test-only override because file-utils hardcoded <cwd>/files; that has not been
# true since the hardening refactor. It also used to list lib/fileUpload.js as a
# consumer: that file has since been deleted.)
# VALIDATED AT BOOT, and reported by name in /ready, so a path that does not
# exist or is not writable refuses the boot rather than failing at first upload.
# UPLOAD_DIRECTORY=

# LDAP request timeout in milliseconds (default 15000)
# LDAP_TIMEOUT_MS=15000

# Public/display root prefixed to HPC file locations returned by the API and
# to read paths in the accessions CSV export. Set this explicitly in production;
# startup warns and falls back to /tsl/data/reads when it is absent.
# READS_ROOT_PATH="/tsl/data/reads"

# Project archival to Amazon S3 (operator CLI only)
# -------------------------------------------------
# These settings are consumed by `npm run archive:s3`; the running API
# does not require AWS credentials or any of these variables.
# Destination root. Project bytes are mirrored below <root>/data/ and sealed
# manifests live below <root>/control/projects/.
# AWS_ARCHIVE_S3_ROOT="s3://example-archive/komondor"

# Safety fence: the mover refuses to run unless STS reports this AWS account.
# AWS_ARCHIVE_EXPECTED_ACCOUNT_ID="123456789012"

# Optional server-side encryption passed to S3 uploads. Supported values are
# AES256 and aws:kms; set the optional key id only with aws:kms.
# AWS_ARCHIVE_SSE="AES256"
# AWS_ARCHIVE_SSE_KMS_KEY_ID="arn:aws:kms:eu-west-2:123456789012:key/..."

# Readiness URL checked before locking a project. Lock expects the API to be
# deliberately quiesced, so a reachable/ready service is a refusal condition.
# KOMONDOR_READY_URL="http://127.0.0.1:3030/ready"

# Storage roots a symlink inside the transfer or datastore directory may point
# into. Colon-separated absolute paths. Symlinking a large file or a project
# directory into the staging area instead of copying it is normal on a cluster;
# without this, any such link is refused. Leave empty to allow none.
# ALLOWED_LINK_ROOTS=/scratch:/projects

{
  "name": "komondor-api",
  "version": "1.0.0",
  "description": "TSL Sequence Data API",
  "author": "George Deeks",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development nodemon --ignore docs/ --ignore datastore/ --ignore files/ server.js",
    "dev:email": "NODE_ENV=production nodemon --ignore docs/ --ignore datastore/ --ignore files/ server.js",
    "dev:no-email": "NODE_ENV=development nodemon --ignore docs/ --ignore datastore/ --ignore files/ server.js",
    "start": "NODE_ENV=production node server.js",
    "archive:s3": "node scripts/move-project-to-s3.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:contract": "jest __tests__/contract/",
    "test:integration": "jest --testPathIgnorePatterns \"/node_modules/\" --testPathPattern \"__tests__/integration/\" --runInBand",
    "test:handles": "jest --detectOpenHandles --runInBand"
  },
  "dependencies": {
    "@tus/file-store": "^1.5.1",
    "@tus/server": "^1.10.2",
    "cors": "^2.8.5",
    "dotenv": "^8.6.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "ldapauth-fork": "^5.0.1",
    "ldapjs": "^2.3.1",
    "mongoose": "^5.13.23",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.10.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "tmp": "^0.2.5"
  }
}

+// Policy (27 November 2026): a Project goes to AWS only once its HPC
+// deletion-review date has passed, i.e. the later of its age-based archive
+// date and any keep date. An earlier copy needs an explicit, recorded reason.
+const reviewDatePolicy = async (context, options, project) => {
+  const supplied = options["before-review-date"];
+  if (supplied !== undefined && (typeof supplied !== "string" || !supplied.trim())) {
+    throw new ArchiveConfigurationError(
+      "--before-review-date requires a reason",
+    );
+  }
+  const earlyCopyReason = supplied === undefined ? null : supplied.trim();
+  const now = new Date(context.now());
+  let dates = null;
+  let unavailable = null;
+  try {
+    dates = await projectRetentionDates(project, {
+      Sample: context.models.Sample,
+      Run: context.models.Run,
+      now,
+    });
+  } catch (error) {
+    unavailable = error.message;
+  }
+  const eligibleFrom = dates?.hpcDeletionEligibleAt ?? null;
+  const passed = eligibleFrom !== null && +new Date(eligibleFrom) <= +now;
+  return {
+    eligibleFrom,
+    archiveDueAt: dates?.archiveDueAt ?? null,
+    passed,
+    ...(dates?.hpcPreservationInvalid ? { keepDateInvalid: true } : {}),
+    ...(unavailable ? { unavailable } : {}),
+    earlyCopyReason,
+  };
+};
+
+const requireReviewDatePassed = (policy) => {
+  if (policy.passed || policy.earlyCopyReason) return;
+  const why = policy.eligibleFrom
+    ? `Project is not due for AWS until ${policy.eligibleFrom}, the later of its age-based archive date and its keep date`
+    : policy.keepDateInvalid
+      ? "Invalid preserveOnHpcUntil, so the HPC deletion-review date is unknown"
+      : `HPC deletion-review date is unavailable${policy.unavailable ? ` (${policy.unavailable})` : ""}`;
+  throw new ArchiveRefusalError(
+    `${why}. To copy it early as a deliberate exception, pass --before-review-date "<reason>"`,
+    { reviewDate: policy },
+  );
+};
